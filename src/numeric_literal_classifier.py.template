#!/usr/bin/env python3
"""Student-owned Python Stage 2 classifier logic.

Edit classify_num_lit(input_text). Do not read stdin or write stdout here; the
protected bridge owns JSON transport and captures accidental stdout.
"""
from __future__ import annotations


def classify_num_lit(input_text: str) -> tuple[str, str]:
    """Classify one numeric literal candidate.

    Return a 2-tuple: (actual, actual_kind)
    - actual: "Accept" or "Reject"
    - actual_kind: BIN_INT|OCT_INT|DEC_INT|ZERO_INT|HEX_INT|FLOAT|IMAG|-
      (use "-" when returning Reject)

    Example accepted input:
    - input_text = "0b101_01" -> ("Accept", "BIN_INT")

    Example rejected input:
    - input_text = "_12" -> ("Reject", "-")
    """
    _ = input_text
    return ("Reject", "-")